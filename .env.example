# ─────────────────────────────────────────────────────────────────────────────
# Overdue / The Ledger — environment configuration
# Copy to .env.local and fill in. Values starting with NEXT_PUBLIC_ are exposed
# to the browser. Keep secrets server-only.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (https://supabase.com) ---
# NOTE: paste your OWN project values here. Do NOT commit real keys.
# If this file ever shipped with keys, rotate them (Supabase -> Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth — Custom SMTP (fixes "sent by Supabase" sender name)
# Configure in Supabase Dashboard → Project Settings → Authentication → SMTP
# Use Resend's SMTP so confirmation emails come from your domain:
#   Host:     smtp.resend.com
#   Port:     465
#   Username: resend
#   Password: <your RESEND_API_KEY>
#   Sender:   Overdue <auth@getoverdue.online>
# Also set the "Sender email" under Authentication → Providers → Email to match.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Overdue
# Set to "production" for live behavior. Use this (NOT NODE_ENV, which Next controls).
APP_ENV=development

# --- Paddle billing (https://www.paddle.com) — PRIMARY merchant of record ---
# Create the Pro product (a $19/mo subscription) in the Paddle dashboard, then
# create a webhook endpoint pointing at
#   https://<your-app>/api/webhooks/paddle
# and copy its signing secret (pdl_ntfset_...) here. Fill in:
#   PADDLE_API_KEY=<API key, server-only, never NEXT_PUBLIC_>
#   PADDLE_WEBHOOK_SECRET=<pdl_ntfset_... from the webhook endpoint you created>
#   PADDLE_ENVIRONMENT=sandbox   # sandbox | live
#   PADDLE_PRICE_PRO_MONTHLY=<Paddle price id (pri_...) for the Pro monthly sub>
# Checkout URLs are created server-side (POST /api/billing/paddle/checkout)
# with custom_data.app_user_id bound and the customer reused by email, so
# webhooks resolve without email matching.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=
# Client-side token for the Paddle.js overlay (public by design). Generate in
# Paddle dashboard → Developer tools → Authentication → Client-side tokens
# (test_... for sandbox, live_... for production). The payment button opens
# the overlay with this; without it checkout falls back to Dodo.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# --- Dodo Payments billing (https://www.dodopayments.com) — DISABLED fallback ---
# Paddle is the primary/single merchant of record. Dodo is kept only for legacy
# subscribers and stays dormant unless DODO_FALLBACK_ENABLED=true:
DODO_FALLBACK_ENABLED=false
# Webhook endpoint: https://<your-app>/api/webhooks/dodo
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_PRO_MONTHLY=

# --- Resend (https://resend.com) ---
RESEND_API_KEY=
# Add this to your domain's DNS (from Resend dashboard), then set below.
RESEND_FROM_EMAIL="Overdue <payments@example.com>"
RESEND_WEBHOOK_SECRET=
# Mailbox that receives replies and bounces so we can detect them.
REPLY_TO_EMAIL=
# Inbound reply/email webhook shared secret (Svix-style from Resend inbound).
INBOUND_WEBHOOK_SECRET=

# --- AI drafting (any OpenAI-compatible endpoint) ---
# Providers are tried in order until one replies: primary (LLM_*), then Groq
# (LLM_API_GROQ), then LLM_FALLBACK_* — so a rate-limited or failing provider
# never blocks drafting. Free tier options: Google AI Studio (Gemini) or
# console.groq.com — neither needs a credit card. Leave LLM_API_KEY empty to
# keep using local template drafting at $0.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Groq (optional second provider):
LLM_API_GROQ=
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_MODEL=openai/gpt-oss-20b
# Generic third provider (optional):
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Optional: suffix to add when no key is configured (free drafting off).
LLM_OFFLINE_FALLBACK=true

# --- Stripe integration (invoice sync + paid webhooks, not billing) ---
# Publishable key is public by design — optional in this file.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Connect platform client id + secret key (sk_...) for OAuth, and the webhook
# signing secret. See the launch guide for where each lives in the dashboard.
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
# Signing secret of the Stripe webhook endpoint (dashboard -> Developers -> Webhooks).
STRIPE_WEBHOOK_SECRET=

# --- PayPal integration (invoice sync + paid webhooks) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Webhook ID of the PayPal webhook (dashboard -> Notifications -> Webhooks).
PAYPAL_WEBHOOK_ID=

# --- Xero integration (OAuth2 + paid webhooks) ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Signing key for Xero webhooks (Xero app -> Webhooks -> signing key).
XERO_WEBHOOK_KEY=

# --- Rate limiting (Upstash Redis, https://upstash.com) ---
# Server-side request throttling (replaces the in-memory limiter in prod).
# Copy the "REST API" URL + token from an Upstash Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring (Sentry, https://sentry.io) ---
# Create a Sentry project, then paste its DSN here. The client uses the
# NEXT_PUBLIC_ variant (it is bundled into the browser bundle); the server and
# edge runtimes use SENTRY_DSN. Integration is inert while these are empty.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Scheduler ---
# Protect /api/cron from unauthorized invocation. Generate: openssl rand -hex 16
CRON_SECRET=
DISPATCH_BATCH_SIZE=200

# --- Inbound email detection ---
# Shared secret sent by your inbound mail webhook (see INBOUND_WEBHOOK_SECRET above).
